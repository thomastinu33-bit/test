export type HmHeatmapTopic =
  | "overall"
  | "apparel"
  | "womensClothing"
  | "mensClothing"
  | "kidsClothing"
  | "accessoriesFootwear"
  | "shoes"
  | "bagsSmallAccessories"
  | "lifestyle"
  | "homeDecorTextiles"
  | "beauty"
  | "cosmeticsPersonalCare";

export interface HmHeatmapScoreRow {
  reportDate: string;
  targetBrand: string;
  modelMaker: string;
  model: string;
  brand: string;
  metric: "AI Brand Score" | "Visibility Score" | "Average Position";
  overall: number;
  apparel: number;
  womensClothing: number;
  mensClothing: number;
  kidsClothing: number;
  accessoriesFootwear: number;
  shoes: number;
  bagsSmallAccessories: number;
  lifestyle: number;
  homeDecorTextiles: number;
  beauty: number;
  cosmeticsPersonalCare: number;
}

export const HM_HEATMAP_TOPIC_KEYS: HmHeatmapTopic[] = [
  "overall",
  "apparel",
  "womensClothing",
  "mensClothing",
  "kidsClothing",
  "accessoriesFootwear",
  "shoes",
  "bagsSmallAccessories",
  "lifestyle",
  "homeDecorTextiles",
  "beauty",
  "cosmeticsPersonalCare",
];

export const HM_HEATMAP_DIM_LABELS: Record<HmHeatmapTopic, string> = {
  overall: "Overall",
  apparel: "Apparel",
  womensClothing: "Women's Clothing",
  mensClothing: "Men's Clothing",
  kidsClothing: "Kids Clothing",
  accessoriesFootwear: "Accessories & Footwear",
  shoes: "Shoes",
  bagsSmallAccessories: "Bags & Small Accessories",
  lifestyle: "Lifestyle",
  homeDecorTextiles: "Home Decor & Textiles",
  beauty: "Beauty",
  cosmeticsPersonalCare: "Cosmetics & Personal Care",
};

export const HM_HEATMAP_GAUGE_DIMENSION_KEYS = HM_HEATMAP_TOPIC_KEYS;

const BRANDS = ["H&M", "Zalando", "C&A", "Esprit", "Tom Tailor", "Jack & Jones", "Peek & Cloppenburg"];
const MODELS = [
  { maker: "OpenAI", model: "ChatGPT" },
  { maker: "Google", model: "Gemini" },
  { maker: "Anthropic", model: "Claude" },
  { maker: "Meta", model: "Llama" },
  { maker: "Perplexity", model: "Perplexity" },
];

function generateMockData(): HmHeatmapScoreRow[] {
  const rows: HmHeatmapScoreRow[] = [];
  const today = new Date("2026-03-07");
  const baseFactor = 1.05; // Germany scores ~5% higher

  for (let daysAgo = 0; daysAgo <= 6; daysAgo++) {
    const date = new Date(today);
    date.setDate(date.getDate() - daysAgo);
    const dateStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;

    for (const brand of BRANDS) {
      for (const model of MODELS) {
        for (const metric of ["AI Brand Score", "Visibility Score", "Average Position"] as const) {
          const baseScore = Math.random() * 100;
          const scoreAdjusted = metric === "Average Position"
            ? Math.random() * 10
            : Math.min(100, baseScore * baseFactor);

          rows.push({
            reportDate: dateStr,
            targetBrand: "H&M",
            modelMaker: model.maker,
            model: model.model,
            brand,
            metric,
            overall: Math.round(scoreAdjusted * 10) / 10,
            apparel: Math.round(scoreAdjusted * 1.02 * 10) / 10,
            womensClothing: Math.round(scoreAdjusted * 1.01 * 10) / 10,
            mensClothing: Math.round(scoreAdjusted * 0.99 * 10) / 10,
            kidsClothing: Math.round(scoreAdjusted * 0.98 * 10) / 10,
            accessoriesFootwear: Math.round(scoreAdjusted * 0.96 * 10) / 10,
            shoes: Math.round(scoreAdjusted * 0.97 * 10) / 10,
            bagsSmallAccessories: Math.round(scoreAdjusted * 0.94 * 10) / 10,
            lifestyle: Math.round(scoreAdjusted * 0.92 * 10) / 10,
            homeDecorTextiles: Math.round(scoreAdjusted * 0.90 * 10) / 10,
            beauty: Math.round(scoreAdjusted * 0.88 * 10) / 10,
            cosmeticsPersonalCare: Math.round(scoreAdjusted * 0.85 * 10) / 10,
          });
        }
      }
    }
  }

  return rows;
}

let cached: HmHeatmapScoreRow[] | null = null;

export function getHmHeatmapScoresGermany(): HmHeatmapScoreRow[] {
  if (cached) return cached;
  cached = generateMockData();
  return cached;
}

export function getLatestReportDate(): string {
  return "2026-03-07";
}

export function getUniqueBrands(): string[] {
  return BRANDS;
}

export function getUniqueModels(): { id: string; label: string }[] {
  return MODELS.map((m) => ({
    id: `${m.maker}|${m.model}`,
    label: m.model,
  }));
}

function getDimensionsForRows(
  rows: HmHeatmapScoreRow[],
  metric: HmHeatmapScoreRow["metric"]
): Record<HmHeatmapTopic, number> {
  const filtered = rows.filter((r) => r.metric === metric);
  const zero = Object.fromEntries(HM_HEATMAP_TOPIC_KEYS.map((k) => [k, 0])) as Record<HmHeatmapTopic, number>;
  if (filtered.length === 0) return zero;
  const sum = { ...zero };
  for (const r of filtered) {
    for (const k of HM_HEATMAP_TOPIC_KEYS) {
      sum[k] += r[k] ?? r.overall;
    }
  }
  const n = filtered.length;
  const out = { ...zero };
  for (const k of HM_HEATMAP_TOPIC_KEYS) {
    out[k] = Math.round((sum[k] / n) * 10) / 10;
  }
  return out;
}

export function getGaugeDimensionsForBrand(
  brand: string,
  model: string,
  metric: "AI Brand Score" | "Visibility Score" | "Average Position"
): Record<HmHeatmapTopic, number> {
  const rows = getHmHeatmapScoresGermany();
  const [maker, modelName] = model.split("|");
  const filtered = rows.filter(
    (r) =>
      r.brand === brand &&
      r.modelMaker === maker &&
      r.model === modelName &&
      r.metric === metric
  );
  return getDimensionsForRows(filtered, metric);
}

export function getTopBrandsByLatestScore(
  metric: "AI Brand Score" | "Visibility Score" | "Average Position",
  limit: number = 10
): Array<{ brand: string; score: number }> {
  const rows = getHmHeatmapScoresGermany();
  const latestDate = "2026-03-07";
  const latest = rows.filter((r) => r.reportDate === latestDate && r.metric === metric);
  const byBrand = new Map<string, number[]>();
  for (const r of latest) {
    if (!byBrand.has(r.brand)) byBrand.set(r.brand, []);
    byBrand.get(r.brand)!.push(r.overall);
  }
  const out: Array<{ brand: string; score: number }> = [];
  for (const [brand, scores] of byBrand) {
    const avg = scores.reduce((a, b) => a + b, 0) / scores.length;
    out.push({ brand, score: Math.round(avg * 10) / 10 });
  }
  return out.sort((a, b) => b.score - a.score).slice(0, limit);
}

export function getResultsTableData(metric: "AI Brand Score" | "Visibility Score" | "Average Position") {
  const rows = getHmHeatmapScoresGermany();
  const latestDate = "2026-03-07";
  const latest = rows.filter((r) => r.reportDate === latestDate && r.metric === metric);
  return latest;
}

export function getTimelineData(
  metric: "AI Brand Score" | "Visibility Score" | "Average Position",
  brand?: string
) {
  const rows = getHmHeatmapScoresGermany();
  const dates = [...new Set(rows.map((r) => r.reportDate))].sort();
  const filtered = brand ? rows.filter((r) => r.brand === brand && r.metric === metric) : rows.filter((r) => r.metric === metric);
  const byDate = new Map<string, number[]>();
  for (const r of filtered) {
    if (!byDate.has(r.reportDate)) byDate.set(r.reportDate, []);
    byDate.get(r.reportDate)!.push(r.overall);
  }
  const avgByDate = dates.map((d) => {
    const vals = byDate.get(d) || [];
    return vals.length > 0 ? Math.round((vals.reduce((a, b) => a + b) / vals.length) * 10) / 10 : 0;
  });
  return { dates, series: [{ name: brand || "Average", data: avgByDate }] };
}

export function getDimensionTimelineData(
  dimension: HmHeatmapTopic,
  metric: "AI Brand Score" | "Visibility Score" | "Average Position"
) {
  const rows = getHmHeatmapScoresGermany();
  const dates = [...new Set(rows.map((r) => r.reportDate))].sort();
  const filtered = rows.filter((r) => r.metric === metric);
  const byDate = new Map<string, number[]>();
  for (const r of filtered) {
    if (!byDate.has(r.reportDate)) byDate.set(r.reportDate, []);
    byDate.get(r.reportDate)!.push(r[dimension] ?? 0);
  }
  const avgByDate = dates.map((d) => {
    const vals = byDate.get(d) || [];
    return vals.length > 0 ? Math.round((vals.reduce((a, b) => a + b) / vals.length) * 10) / 10 : 0;
  });
  return { dates, series: [{ name: HM_HEATMAP_DIM_LABELS[dimension], data: avgByDate }] };
}

export function getGaugeDimensionsForModelWithChange(
  model: string,
  metric: "AI Brand Score" | "Visibility Score" | "Average Position"
): {
  dimensions: Record<HmHeatmapTopic, number>;
  changeDimensions: Record<HmHeatmapTopic, number>;
} {
  const rows = getHmHeatmapScoresGermany();
  const [maker, modelName] = model.split("|");
  const latest = rows
    .filter((r) => r.modelMaker === maker && r.model === modelName && r.metric === metric)
    .sort((a, b) => b.reportDate.localeCompare(a.reportDate));
  const latestDims = getDimensionsForRows(latest.slice(0, 1), metric);
  const prevDims = getDimensionsForRows(latest.slice(1, 8), metric);
  const changeDims = { ...latestDims };
  for (const k of HM_HEATMAP_TOPIC_KEYS) {
    changeDims[k] = Math.round((latestDims[k] - prevDims[k]) * 10) / 10;
  }
  return { dimensions: latestDims, changeDimensions: changeDims };
}

export function getTopicModelScores(
  topic: HmHeatmapTopic,
  metric: "AI Brand Score" | "Visibility Score" | "Average Position",
  limit: number = 10
): Array<{ model: string; score: number }> {
  const rows = getHmHeatmapScoresGermany();
  const latestDate = "2026-03-07";
  const latest = rows.filter((r) => r.reportDate === latestDate && r.metric === metric);
  const byModel = new Map<string, number[]>();
  for (const r of latest) {
    const modelId = `${r.modelMaker}|${r.model}`;
    if (!byModel.has(modelId)) byModel.set(modelId, []);
    byModel.get(modelId)!.push(r[topic] ?? 0);
  }
  const out: Array<{ model: string; score: number }> = [];
  for (const [model, scores] of byModel) {
    const avg = scores.reduce((a, b) => a + b, 0) / scores.length;
    out.push({ model, score: Math.round(avg * 10) / 10 });
  }
  return out.sort((a, b) => b.score - a.score).slice(0, limit);
}

export function getHmHeatmapBrands(): string[] {
  return getUniqueBrands();
}
